---
// Dev-only review page: the Life timeline drawn from fixtures (src/data/life-card-examples.ts) by the same
// LifeTimeline and LifeCard components as /life/, so every card family and layout case can be checked in one place.
// `collapse={false}`: older years are not folded into <details> here, so every fixture stays visible.
// Absent from production builds.
import Base from '../../../layouts/Base.astro';
import LifeTimeline from '../../../components/life/LifeTimeline.astro';
import { lifeCardExamples } from '../../../data/life-card-examples';

// Dynamic route on purpose: Astro ignores getStaticPaths on a static route, so this keeps it out of production.
export function getStaticPaths() {
  return import.meta.env.PROD ? [] : [{ params: { page: 'cards' } }];
}
---
<Base title="Life cards review" description="Review page: every Life timeline card family with its variants. Fixtures, not content." noindex nav={null}>
<section class="pagehead"><div class="wrap col">
  <p class="cat" lang="tr">LIFE KARTLARI · İNCELEME</p>
  <h1 class="h2" lang="tr">Life kart aileleri.</h1>
  <p class="small lede-600" lang="tr">Yedi post tipi, üç kart ailesi (compact, standard, featured) ve yerleşim durumları tek sayfada. Buradaki kartlar Life sayfasıyla aynı kodla çizilir. Köşeli parantez içindeki her metin örnektir; içerik değildir.</p>
</div></section>
<LifeTimeline entries={lifeCardExamples} lang="en" collapse={false} />
</Base>
