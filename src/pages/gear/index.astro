---
import { showSamples } from '../../lib/posts';
// gear.html. One markdown file per device in src/content/gear/; counts and sections are computed.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const all = (await getCollection('gear', (g) => (import.meta.env.DEV || !g.data.draft) && (showSamples || !g.data.sample))).map((g) => g);
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const monthYear = (s: string) => (/^\d{4}-\d{2}$/.test(s) ? `${MONTHS[+s.slice(5) - 1]} ${s.slice(0, 4)}` : s);

const CATS = [
  { id: 'computing', key: 'computing', label: 'Computing', recent: 'Computing' },
  { id: 'audio-video', key: 'audio-video', label: 'Audio and video', recent: 'Audio and video' },
  { id: 'wearables', key: 'wearables', label: 'Wearables', recent: 'Wearables' },
  { id: 'home-network', key: 'home', label: 'Home and network', recent: 'Home and network' },
  { id: 'workshop', key: 'workshop', label: 'Workshop', recent: 'Workshop' },
  { id: 'play', key: 'play', label: 'Play', recent: 'Play' },
  { id: 'everyday', key: 'everyday', label: 'Everyday', recent: 'Everyday carry' },
] as const;

const RECENT_SINCE = '2026-08'; // "added since August"; move forward when the strip gets stale
const inUse = all.filter((g) => g.data.status === 'in-use').length;
const gone = all.length - inUse;
const recent = all
  .filter((g) => g.data.since >= RECENT_SINCE)
  .sort((a, b) => b.data.since.localeCompare(a.data.since))
  .slice(0, 3);
const added = all.filter((g) => g.data.since >= RECENT_SINCE).length;
const tones = ['sage', 'warm', 'blue'];
const status = { 'in-use': 'In use', retired: 'Retired', sold: 'Sold' } as const;
const rank = (s: string) => (s === 'in-use' ? 0 : 1);
const sections = CATS.map((c) => ({
  ...c,
  items: all
    .filter((g) => g.data.category === c.id)
    .sort((a, b) => rank(a.data.status) - rank(b.data.status) || b.data.since.localeCompare(a.data.since)),
})).filter((c) => c.items.length);
const sample = all.some((g) => g.data.sample);
---
<Base title="Gear" description="Everything I actually use, with how long I have used it and whether I would buy it again. No affiliate links." originalLang="en">
<div class="wrap original-language-note" data-original-note hidden></div>

<section class="pagehead gear-head">
  <div class="wrap grid">
    <div class="span7 col">
      <h1 class="h1">Gear</h1>
      <p class="lede">Everything I actually use, with how long I have used it and whether I would buy it again. Updated when something arrives or leaves. No affiliate links. {sample && <span class="mock">items are examples</span>}</p>
    </div>
    <div class="span5">
      <ul class="stat-strip n3">
        <li><span class="fig">{inUse}</span><span class="tiny">in use</span></li>
        <li><span class="fig">{gone}</span><span class="tiny">retired or sold</span></li>
        <li><span class="fig">{added}</span><span class="tiny">added since August</span></li>
      </ul>
    </div>
  </div>
</section>

{recent.length > 0 && (
<section class="section gear-recent" aria-labelledby="recent-h">
  <div class="wrap">
    <div class="sechead"><h2 class="h3" id="recent-h">Recently added</h2></div>
    <div class="g3">
      {recent.map((g, i) => (
        <article class="panel card unavailable" data-no-label>
          <div class={`ph r43 ${tones[i % 3]}`}><span class="cap">{i === 0 ? 'Product photo, your own' : 'Product photo'}</span></div>
          <div class="row"><span class="tiny">{CATS.find((c) => c.id === g.data.category)?.recent} <span class="origin-chip" title="Written in English">EN</span></span><span class={i === 0 ? 'tag warm' : 'tag'}>{i === 0 ? `New, ${monthYear(g.data.since)}` : monthYear(g.data.since)}</span></div>
          <h3 class="h4">{g.data.name}</h3>
          <p class="small">{g.data.take}</p>
        </article>
      ))}
    </div>
  </div>
</section>
)}

<section class="section gear-cats">
  <div class="wrap">
    {sections.map((c) => (
      <section class="grid" aria-labelledby={`cat-${c.key}`}>
        <div class="span3 col"><h2 class="h3" id={`cat-${c.key}`}>{c.label}</h2><p class="tiny">{c.items.length} {c.items.length === 1 ? 'item' : 'items'}{c.key === 'home' && <>. Full setup in <a class="link" href="/projects/smart-home/">the smart home project</a>.</>}</p></div>
        <div class="span9">
          <ul class="gear-list">
            {c.items.map((g) => (
              <li class:list={['gear-row', { retired: g.data.status !== 'in-use' }]}><b>{g.data.name}</b><span class="tiny">{g.data.until ? `${g.data.since} to ${g.data.until}` : `Since ${g.data.since}`}</span><p class="small">{g.data.take}</p><span class="tag">{status[g.data.status]}</span></li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>
</section>
</Base>
