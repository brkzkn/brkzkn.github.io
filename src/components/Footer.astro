---
// Site footer. The "preview" line is a launch-cleanup marker, shown only while PUBLIC_PREVIEW !== 'false'.
import { localizePath, type Locale } from '../i18n';
import { translations } from '../scripts/i18n/tr';
interface Props { minimal?: boolean }
const { minimal = false } = Astro.props;
const preview = import.meta.env.PUBLIC_PREVIEW !== 'false';
const locale: Locale = Astro.currentLocale === 'tr' ? 'tr' : 'en';
const t = (text: string) => (locale === 'tr' ? translations[text] ?? text : text);
const link = (path: string) => localizePath(path, locale);
---
<footer class="foot"><div class="wrap">{!minimal && <div class="grid"><div class="span5 col"><p class="brand">Burak Özkan</p><p class="lede">{t('Systems I design, things I build, a life worth remembering.')}</p></div><div class="span3"><h4>{t('Explore')}</h4><ul><li><a href={link('/work/')}>{t('Work')}</a></li><li><a href={link('/projects/')}>{t('Projects')}</a></li><li><a href={link('/life/')}>{t('Life')}</a></li><li><a href={link('/writing/')}>{t('Writing')}</a></li></ul></div><div class="span4"><h4>{t('About & follow')}</h4><ul><li><a href={link('/about/')}>{t('About / contact')}</a></li><li><a href={link('/gear/')}>{t('My gear')}</a></li><li><a class="sidebar-rss" href="/rss.xml">RSS feed</a></li></ul></div></div>}<div class="end"><span>© 2026 Burak Özkan · Istanbul · <a href={link('/privacy/')}>{t('Privacy')}</a></span>{preview && !minimal && <span>V4.2 preview · Sample entries and illustrative images</span>}</div></div></footer>
