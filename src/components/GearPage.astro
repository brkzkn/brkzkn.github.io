---
// Gear: hero (title, lede, photo), category filter row, one card grid. Cards are informational only: no links out. /gear/ and /tr/gear/ render it
// (ADR-006, src/i18n/translated.ts). Devices come from src/content/gear/ through src/lib/gear.ts; the filter is the
// island src/scripts/gear-filters.ts (data-gear-* attributes, client-side only, no URL change).
// The hero photo is a single constant below so the owner's real desk photo can replace the placeholder in one line.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { GEAR_CATEGORIES, categoryLabel, getGear, type GearLang } from '../lib/gear';

interface Props { lang: GearLang }
const { lang } = Astro.props;
const tr = lang === 'tr';

// Set to a path under public/ (e.g. '/assets/images/gear-hero.jpg', landscape, about 1600×1000) once a real photo exists.
const HERO_IMAGE: string | null = '/assets/images/gear-hero.jpg';

const items = await getGear();
const counts = Object.fromEntries(GEAR_CATEGORIES.map((c) => [c.id, items.filter((g) => g.data.category === c.id).length])) as Record<string, number>;
const hasSamples = items.some((g) => g.data.sample);

const c = tr
  ? {
      title: 'Kullandığım Cihazlar',
      description: 'İşimde, hobilerimde ve günlük hayatımda kullandığım, zaman zaman da kurcalamaktan keyif aldığım cihazlar.',
      heroAlt: 'Akşam ışığında çalışma masası: ultrawide monitör, laptop, kulaklık, telefon ve gözlük',
      heroCap: 'Fotoğraf: akşam ışığında çalışma masası',
      all: 'Tümü', filterLabel: 'Kategoriye göre filtrele',
      one: '1 cihaz', many: '{n} cihaz',
      ratingLabel: 'Benim puanım', rated: (r: string) => `5 üzerinden ${r} puan`,
      emptyH: 'Bu kategoride henüz cihaz yok.', emptyP: 'Başka bir kategori seç ya da tüm listeye dön.', emptyBtn: 'Tümünü göster',
      noneH: 'Liste henüz boş.', noneP: 'Cihazları tek tek, gerçekten kullandıkça ekleyeceğim. Yakında.',
      sampleNote: 'Örnek kayıtlar: tasarım için eklendi, gerçek envanter değil.',
    }
  : {
      title: 'Gear',
      description: 'The gear I use for work, hobbies, and everyday life—and enjoy tinkering with along the way.',
      heroAlt: 'Desk in evening light: ultrawide monitor, laptop, headphones, phone and glasses',
      heroCap: 'Photo: desk in evening light',
      all: 'All', filterLabel: 'Filter by category',
      one: '1 device', many: '{n} devices',
      ratingLabel: 'My rating', rated: (r: string) => `Rated ${r} out of 5`,
      emptyH: 'Nothing in this category yet.', emptyP: 'Pick another category or go back to the full list.', emptyBtn: 'Show all',
      noneH: 'The list is empty for now.', noneP: 'Devices get added one by one, as I actually use them. Soon.',
      sampleNote: 'Sample entries: added for the design, not a verified inventory.',
    };

// Outline icons, 24px grid, same stroke as the About page; `star` is filled.
const icon: Record<string, string> = {
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  laptop: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M2 19h20"/>',
  wifi: '<path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.5 15.5a5 5 0 0 1 7 0"/><circle cx="12" cy="19" r="1" fill="currentColor"/>',
  cube: '<path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/>',
  zap: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  gamepad: '<path d="M6 8h12a4 4 0 0 1 4 4v3a3 3 0 0 1-5.5 1.7L15.5 15h-7l-1 1.7A3 3 0 0 1 2 15v-3a4 4 0 0 1 4-4Z"/><path d="M8 11v3M6.5 12.5h3"/><circle cx="16" cy="11.5" r=".6" fill="currentColor"/><circle cx="18" cy="13.5" r=".6" fill="currentColor"/>',
  star: '<path d="m12 2.8 2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.6l-5.8 3 1.1-6.4-4.7-4.6 6.5-.9L12 2.8Z"/>',
};
const Svg = (name: string, size = 16) =>
  `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;

// Personal rating (0.5 steps). Five decorative stars: full, half (clipped overlay) or empty; one accessible sentence carries the value.
const formatRating = (r: number) => (tr ? String(r).replace('.', ',') : String(r));
const starKind = (r: number, i: number): 'full' | 'half' | 'empty' => (r >= i + 1 ? 'full' : r >= i + 0.5 ? 'half' : 'empty');
const StarPath = `<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true">${icon.star}</svg>`;
---
<Base title={c.title} description={c.description} originalLang={lang}>

<section class="gear-hero">
  <div class="wrap grid">
    <div class="span6 col gear-hero-text">
      <span class="gear-rule" aria-hidden="true"></span>
      <h1 class="h1">{c.title}</h1>
      <p class="lede">{c.description}</p>
      {hasSamples && <p class="tiny"><span class="mock">{c.sampleNote}</span></p>}
    </div>
    <div class="span6 gear-hero-media">
      {HERO_IMAGE
        ? <img src={HERO_IMAGE} alt={c.heroAlt} width="1672" height="941" loading="eager" fetchpriority="high" decoding="async">
        : <div class="ph warm gear-hero-ph" role="img" aria-label={c.heroCap}><span class="cap">{c.heroCap}</span></div>}
    </div>
  </div>
</section>

{items.length === 0 ? (
<section class="section gear-body">
  <div class="wrap">
    <div class="journal-empty gear-none"><h2 class="h4">{c.noneH}</h2><p class="small">{c.noneP}</p></div>
  </div>
</section>
) : (
<section class="section gear-body" data-gear-root data-one={c.one} data-many={c.many}>
  <div class="wrap">
    <div class="gear-filters" role="group" aria-label={c.filterLabel}>
      <button type="button" class="gear-filter" data-gear-filter="all" aria-pressed="true"><span class="gear-filter-icon" set:html={Svg('grid', 15)} />{c.all} <span class="gear-filter-count">({items.length})</span></button>
      {GEAR_CATEGORIES.filter((cat) => counts[cat.id] > 0).map((cat) => (
        <button type="button" class="gear-filter" data-gear-filter={cat.id} aria-pressed="false"><span class="gear-filter-icon" set:html={Svg(cat.icon, 15)} />{cat[lang]} <span class="gear-filter-count">({counts[cat.id]})</span></button>
      ))}
    </div>
    <p class="filter-summary gear-summary" aria-live="polite" data-gear-summary>{c.many.replace('{n}', String(items.length))}</p>

    <ul class="gear-grid" data-gear-grid>
      {items.map((g) => {
        const cat = GEAR_CATEGORIES.find((x) => x.id === g.data.category)!;
        const take = tr ? g.data.takeTr ?? g.data.take : g.data.take;
        const alt = (tr ? g.data.imageAltTr ?? g.data.imageAlt : g.data.imageAlt) ?? g.data.name;
        return (
          <li class="gear-card" data-gear-category={g.data.category}>
            <div class:list={['gear-media', { contain: g.data.imageFit === 'contain' }]}>
              {g.data.image
                ? <Picture src={g.data.image} alt={alt} widths={[400, 800, 1200]} sizes="(max-width: 767px) 100vw, (max-width: 1199px) 50vw, 400px" formats={['avif', 'webp']} loading="lazy" decoding="async" />
                : <span class="gear-media-fallback" set:html={Svg(cat.icon, 44)} />}
              <span class="gear-badge"><span class="gear-badge-icon" set:html={Svg(cat.icon, 14)} />{categoryLabel(cat.id, lang)}</span>
            </div>
            <div class="gear-card-body">
              <h3 class="gear-name">{g.data.name}</h3>
              <p class="small gear-take">{take}</p>
            </div>
            {g.data.rating !== undefined && (
              <div class="gear-card-foot gear-rating" role="img" aria-label={`${c.ratingLabel}: ${c.rated(formatRating(g.data.rating))}`}>
                <span class="gear-rating-label" aria-hidden="true">{c.ratingLabel}</span>
                <span class="gear-rating-value" aria-hidden="true">
                  <span class="gear-stars">
                    {[0, 1, 2, 3, 4].map((i) => <span class:list={['gear-star', starKind(g.data.rating!, i)]}><span class="gear-star-base" set:html={StarPath} /><span class="gear-star-fill" set:html={StarPath} /></span>)}
                  </span>
                  <span class="gear-rating-num">{formatRating(g.data.rating)}/5</span>
                </span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
    <div class="journal-empty gear-empty" data-gear-empty hidden><h2 class="h4">{c.emptyH}</h2><p class="small">{c.emptyP}</p><button type="button" data-gear-reset>{c.emptyBtn} →</button></div>
  </div>
</section>
)}

<script>import '../scripts/gear-filters.ts';</script>
</Base>
