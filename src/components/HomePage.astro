---
// Home (prototype: index.html): hero, "Selected architecture" strip (ADR-004), the chronological journal feed and its sidebar.
// The feed is rendered at build time from the posts collection (src/components/feed/); src/scripts/feed.ts only filters.
import Base from '../layouts/Base.astro';
import Entry from './feed/Entry.astro';
import SocialLinks from './SocialLinks.astro';
import SelectedArchitecture from './work/SelectedArchitecture.astro';
import { getFeedEntries, feedCategoryLabels, parts, monthName } from '../lib/feed';

// The real home page. Rendered at `/` once PUBLIC_COMING_SOON is off, and always at the unlisted `/preview/`.
interface Props { noindex?: boolean }
const { noindex = false } = Astro.props;
const entries = await getFeedEntries();
const monthKeys = [...new Set(entries.map((e) => parts(e).month))];
const preview = import.meta.env.PUBLIC_PREVIEW !== 'false';
const description = 'Burak Özkan’s personal space for architecture, projects and life.' + (preview ? ' Design preview with sample content.' : '');
const cats = Object.entries(feedCategoryLabels);
---
<Base title="Burak Özkan — Architecture, Projects & Life" rawTitle description={description} nav="home" noindex={noindex}>
<Fragment slot="head"><script>import '../scripts/feed.ts';</script></Fragment>

<section style="padding: 64px 0 56px; border-bottom: 1px solid var(--line)" class="v4-hero">
  <div class="wrap grid" style="align-items: center">
    <div class="span7 col" style="gap: 24px">
      <p class="small" style="display: flex; gap: 12px; align-items: center"><span style="display: inline-block; width: 28px; height: 1px; background: var(--orange)"></span>Burak Özkan · Engineering Leader · Technical Architect · Builder</p>
      <h1 class="h1" style="font-size: 58px; max-width: 760px">A personal space for the systems I design, the things I build, and the life I want to remember.</h1>
      <p class="body-l muted" style="max-width: 560px">I design software systems, lead engineering teams, and love bringing my ideas and curiosities to life. This is my little corner of the internet, where I share what I build, what I learn, and little moments from my life.</p>
      <div class="hero-actions"><a class="btn primary" href="/work/">Architecture work →</a><a class="btn" href="/about/#social-profiles">Get in touch ↓</a></div>
    </div>
    <div class="span5" style="display: grid; grid-template-columns: 5fr 4fr; grid-template-rows: auto auto; gap: 12px; align-items: stretch">
      <img src="/assets/images/hero-istanbul.jpg" alt="Istanbul rooftops at dawn" style="grid-row: span 2; width: 100%; height: 100%; min-height: 360px; object-fit: cover; border-radius: 4px; display: block" loading="eager">
      <img src="/assets/images/hero-workshop.jpg" alt="Workshop bench with printed parts" style="width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 4px; display: block" loading="eager">
      <img src="/assets/images/hero-family.jpg" alt="Family at the shore, facing the sea" style="width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 4px; display: block" loading="eager">
    </div>
  </div>
</section>

<SelectedArchitecture />

<section style="padding: 40px 0 72px">
  <div class="wrap grid" style="align-items: start">

    <div class="span8 col timeline-stream" style="gap: 0" data-feed><div class="timeline-heading"><span class="cat">PERSONAL JOURNAL</span><h2 class="h3">Along the way.</h2><p class="small">Things built, places visited, moments remembered.</p></div>

      <div class="feed-toolbar">
        <label class="journal-search-field mobile-journal-search"><input type="search" data-search data-feed-search data-search-scope="journal" placeholder="Search notes, trips, projects…" aria-label="Search the journal"></label>
        <div class="filters" role="group" data-feed-filters aria-label="Filter by category">
          {['all', ...cats.map(([k]) => k)].map((k) => <button type="button" data-feed-category={k} aria-pressed="false">{k === 'all' ? 'All' : feedCategoryLabels[k]}</button>)}
        </div>
      </div>
      <div class="feed-status"><p class="filter-summary" aria-live="polite" data-feed-summary></p><button type="button" class="feed-clear" data-feed-reset disabled>Clear filters ↺</button></div>
      {preview && <p class="tiny feed-lang-note">Interface labels follow the language toggle. Sample entries stay in their original language, marked on each entry.</p>}
      <div data-feed-list>
        {entries.map((e, i) => <Entry entry={e} first={i === 0} last={i === entries.length - 1} />)}
      </div>
      <div class="journal-empty" data-feed-empty hidden><h3 class="h4">No entries found.</h3><p class="small">Try a different search or clear the filters.</p><button type="button" data-feed-reset>Show all entries →</button></div>
      <div class="feed-end"><p class="tiny">{preview ? 'End of the sample journal.' : 'End of the journal.'}</p><button type="button" class="feed-top" data-feed-top>Back to filters ↑</button></div>
    </div>

    <aside class="span4 journal-sidebar" aria-label="Journal tools"><section class="sidebar-module">
<p class="sidebar-kicker">ELSEWHERE</p>
<div class="sidebar-elsewhere">
<SocialLinks />
</div>
</section>
<section class="sidebar-module sidebar-now">
<p class="sidebar-kicker">NOW</p>
<p class="small">Reading [book]. Rebuilding the hallway dashboard. Planning a December trip. Last updated 28 Oct.</p>
</section>

<section class="sidebar-module sidebar-search"><p class="sidebar-kicker">FIND SOMETHING</p><h2 class="h4">Search the journal</h2><label class="journal-search-field"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input type="search" data-search data-feed-search data-search-scope="journal" placeholder="Search notes, trips, projects…" aria-label="Search the journal"></label><p class="tiny">Search across the entries on this page.</p></section>
<section class="sidebar-module"><p class="sidebar-kicker">BROWSE BY TOPIC</p><div class="sidebar-topics" data-feed-topics>
  <button type="button" data-feed-category="all" aria-pressed="false"><span>All entries</span><span class="sidebar-count" data-count-category="all"></span></button>
  {cats.map(([k, l]) => <button type="button" data-feed-category={k} aria-pressed="false"><span>{l}</span><span class="sidebar-count" data-count-category={k}></span></button>)}
</div></section>
<section class="sidebar-module"><p class="sidebar-kicker">JOURNAL ARCHIVE</p><h2 class="h4">A month at a time.</h2><div class="sidebar-months" data-feed-months>
  <button type="button" data-feed-month="all" aria-pressed="false"><span>All months</span><span class="sidebar-count" data-count-month="all"></span></button>
  {monthKeys.map((k) => <button type="button" data-feed-month={k} aria-pressed="false"><span>{monthName(k)}</span><span class="sidebar-count" data-count-month={k}></span></button>)}
</div><button type="button" class="sidebar-reset" data-feed-reset disabled>Clear filters ↺</button></section>
<section class="sidebar-module sidebar-shortcuts"><p class="sidebar-kicker">TAKE A DIFFERENT PATH</p><a href="/work/"><span>Architecture case studies</span><span aria-hidden="true">↗</span></a><a href="/projects/"><span>Things I build</span><span aria-hidden="true">↗</span></a><a href="/gear/"><span>My gear</span><span aria-hidden="true">↗</span></a><a href="/life/"><span>Life journal</span><span aria-hidden="true">↗</span></a><a class="sidebar-rss" href="/rss.xml"><span>RSS feed</span><span aria-hidden="true">↗</span></a></section>
</aside>
  </div>
</section>
</Base>
